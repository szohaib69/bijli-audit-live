# Required — OpenRouter API key for bill extraction + Bijli chat
OPENROUTER_API_KEY=

# Where the frontend talks to the backend (set on Vercel, not here)
# NEXT_PUBLIC_API_URL=

# Comma-separated origins allowed to call this API
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bijli-audit-web-app.vercel.app

# SQLite database file. On Railway, point this at your mounted volume,
# e.g. sqlite:////data/bijli_audit.db
# DATABASE_URL=sqlite:///bijli_audit.db

# Where uploaded bill images are stored (used by the backup ZIP)
# DATA_DIR=media